# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=moodle
MYSQL_USER=moodleuser
MYSQL_PASSWORD=moodlepassword

# Moodle Site Configuration
# Change MOODLE_WWWROOT to your actual domain in production
MOODLE_WWWROOT=http://localhost:9000
MOODLE_SITE_FULLNAME=Moodle Site
MOODLE_SITE_SHORTNAME=Moodle
MOODLE_SITE_SUMMARY=Moodle Learning Management System

# Moodle Admin Account
# WARNING: Change these credentials before deploying to production!
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin@123
MOODLE_ADMIN_EMAIL=admin@example.com
