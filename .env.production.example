# Production Environment Variables
# Copy this file to .env.production and modify with your actual values
# Then deploy with: docker-compose --env-file .env.production up -d

# =============================================================================
# MYSQL CONFIGURATION
# =============================================================================
# IMPORTANT: Use strong, unique passwords in production!
# Generate with: openssl rand -base64 32

MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_VERY_STRONG_PASSWORD
MYSQL_DATABASE=moodle
MYSQL_USER=moodleuser
MYSQL_PASSWORD=CHANGE_THIS_TO_ANOTHER_STRONG_PASSWORD

# =============================================================================
# MOODLE SITE CONFIGURATION
# =============================================================================
# Set to your actual domain with HTTPS
MOODLE_WWWROOT=https://moodle.yourdomain.com

# Customize your site name
MOODLE_SITE_FULLNAME=Your School Name
MOODLE_SITE_SHORTNAME=YourSchool
MOODLE_SITE_SUMMARY=Online Learning Platform for Your School

# =============================================================================
# ADMIN ACCOUNT
# =============================================================================
# First admin account - change these immediately!
# Password requirements: 
#   - At least 8 characters
#   - Mix of uppercase and lowercase
#   - At least one number
#   - At least one special character

MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_THIS_ComplexPassword123!@#
MOODLE_ADMIN_EMAIL=admin@yourdomain.com

# =============================================================================
# PHP CONFIGURATION (Performance Tuning)
# =============================================================================
PHP_MEMORY_LIMIT=1024M
PHP_MAX_EXECUTION_TIME=600

# =============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# =============================================================================
# 1. Change ALL passwords above
# 2. Set MOODLE_WWWROOT to your HTTPS domain
# 3. Configure SSL/TLS (see DOCKER_README.md)
# 4. Disable phpMyAdmin and MailHog services
# 5. Configure real SMTP server in Moodle admin
# 6. Set up regular backups
# 7. Don't expose MySQL port (9001) to public
# 8. Use firewall rules and security groups
# 9. Monitor logs regularly: docker-compose logs -f
# 10. Keep Docker images updated: docker-compose pull

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
# [ ] Changed all default passwords
# [ ] HTTPS enabled with valid SSL certificate
# [ ] Firewall configured (only 80/443 public)
# [ ] Regular backups scheduled
# [ ] Monitoring and alerting setup
# [ ] Real SMTP configured (not MailHog)
# [ ] phpMyAdmin disabled in production
# [ ] Source code not mounted (use volumes only)
# [ ] Docker images updated to latest stable
# [ ] Resource limits set in docker-compose.yml
